# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bombita.nyc

# Primary "GET TICKETS" link (events can override with their own ticketUrl)
NEXT_PUBLIC_TICKET_URL=https://www.boletosexpress.com/?search=Bombita+
NEXT_PUBLIC_TABLE_URL=https://wa.me/message/FBGQHK7QC46PN1

# Sanity CMS — leave empty to use the local files in /data
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_READ_TOKEN=

# Shopify Storefront API — leave empty to use placeholder products
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Admin dashboard (/admin)
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions
ADMIN_SECRET=
# Vercel Blob store (event data + uploaded flyers). Added automatically when
# you connect a Blob store to the project in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# ── Media library (Neon PostgreSQL) — see docs/MEDIA.md ─────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Use Neon's *pooled* connection
# string (host contains "-pooler") and keep sslmode=require. Format:
#   postgresql://ROLE:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional read-only role for public gallery reads (falls back to DATABASE_URL).
DATABASE_URL_READONLY=
# Optional owner role used only by `npm run db:migrate` (falls back to DATABASE_URL).
DATABASE_MIGRATION_URL=
# Connections per server instance (default 3).
DATABASE_POOL_MAX=
# Admin storage bar budget for web renditions in Blob, in bytes (default ~900 MB; Hobby Blob = 1 GB).
MEDIA_STORAGE_BUDGET_BYTES=
# Blob access for media renditions: private (served via /api/media + CDN cache) or public. Auto-detected if empty.
MEDIA_BLOB_ACCESS=
# Local-storage folder used when no Blob store is configured (dev/tests). Default .data/media
MEDIA_LOCAL_DIR=
